{
  "$schema": "https://unpkg.com/knip@6/schema.json",
  "workspaces": {
    ".": {
      "entry": [
        "e2e/**/*.ts"
      ],
      "vitest": {
        "config": [
          "vitest.config.ts",
          "vitest.integration.config.ts"
        ]
      }
    },
    "apps/web": {
      "entry": [
        "index.html"
      ]
    }
  },
  "ignoreDependencies": [
    "jscpd"
  ],
  "ignore": [
    "docs/**",
    "drills/**",
    "learning-tests/**"
  ],
  "includeEntryExports": true
}
